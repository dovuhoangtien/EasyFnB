idth="250" height="90" as="geometry"/></mxCell><mxCell id="owni" value="" style="image;aspect=fixed;perimeter=ellipsePerimeter;html=1;align=center;shadow=0;dashed=0;spacingTop=3;image=img/lib/active_directory/users.svg;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="own"><mxGeometry x="14" y="23.0" width="29" height="44" as="geometry"/></mxCell><mxCell id="ownt" value='&lt;b style="font-size:14px"&gt;Chủ quán: trình duyệt&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#3c4043"&gt;Trang quản lý · trợ lý · cài đặt&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="own"><mxGeometry x="70" y="6" width="172" height="78" as="geometry"/></mxCell><mxCell id="stf" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="55" y="700" width="250" height="110" as="geometry"/></mxCell><mxCell id="stfi" value="" style="sketch=0;verticalLabelPosition=bottom;sketch=0;aspect=fixed;html=1;verticalAlign=top;strokeColor=none;fillColor=#000000;align=center;outlineConnect=0;pointerEvents=1;shape=mxgraph.citrix2.mobile;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="stf"><mxGeometry x="14" y="33.0" width="22" height="44" as="geometry"/></mxCell><mxCell id="stft" value='&lt;b style="font-size:14px"&gt;Nhân viên: điện thoại&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#3c4043"&gt;Web app: nhận việc, rung&lt;br&gt;Giọng đọc tiếng Việt của máy&lt;br&gt;(không có TTS trên server)&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="stf"><mxGeometry x="70" y="6" width="172" height="98" as="geometry"/></mxCell><mxCell id="run" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285f4;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="440" y="150" width="380" height="250" as="geometry"/></mxCell><mxCell id="runi" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="run"><mxGeometry x="16" y="14" width="48" height="48" as="geometry"/></mxCell><mxCell id="runt" value='&lt;b style="font-size:16px;color:#1a73e8"&gt;Cloud Run · easy-fnb&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" vertex="1" parent="run"><mxGeometry x="76" y="14" width="290" height="48" as="geometry"/></mxCell><mxCell id="runb" value='&lt;span style="font-size:12.5px;color:#3c4043"&gt;FastAPI + web React trong một container&lt;br&gt;Hub: việc, bàn, nhật ký ca → trong RAM&lt;br&gt;Trợ lý Google ADK (phiên trong RAM)&lt;br&gt;gen2 · 1 vCPU · 1 GiB · CPU luôn cấp&lt;br&gt;đúng 1 instance (min 1 · max 1)&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="run"><mxGeometry x="16" y="76" width="350" height="110" as="geometry"/></mxCell><mxCell id="runs" value='&lt;span style="font-size:12px;color:#5f6368"&gt;Service account: easy-fnb-run (quyền tối thiểu)&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12.5px;color:#c5221f"&gt;⚠ Chỉ /api/edge/* có khoá, còn lại mở (ADR-0007)&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="run"><mxGeometry x="16" y="196" width="350" height="44" as="geometry"/></mxCell><mxCell id="sec" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;strokeWidth=2;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="300" height="110" as="geometry"/></mxCell><mxCell id="seci" value="" style="sketch=0;html=1;verticalAlign=top;label