<mxfile host="drawio" version="26.0.0"><diagram name="Kiến trúc đích" id="gcp-target"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value='&lt;b style="font-size:24px"&gt;Easy FnB: kiến trúc tổng thể (đích): suy luận chạy trên Google Cloud&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#5f6368"&gt;Quán chỉ cần cổng phát luồng và nhận kết quả · chế độ edge (GPU tại quán) giữ lại như một lựa chọn · phần chịu tải nằm trong thiết kế, chưa nằm trong IaC demo&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1500" height="60" as="geometry"/></mxCell><mxCell id="z_venue" value="Tại quán (không cần GPU)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=0;pointerEvents=0;fillColor=#f8f9fa;strokeColor=#9aa0a6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#5f6368;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="300" height="600" as="geometry"/></mxCell><mxCell id="z_users" value="Người dùng (chỉ nhận kết quả)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=0;pointerEvents=0;fillColor=#f8f9fa;strokeColor=#9aa0a6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#5f6368;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="30" y="730" width="300" height="300" as="geometry"/></mxCell><mxCell id="z_gcp" value="Google Cloud · asia-southeast1 · kiến trúc đích" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=0;pointerEvents=0;fillColor=#f6faff;strokeColor=#4285f4;strokeWidth=2.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#1a73e8;" vertex="1" parent="1"><mxGeometry x="370" y="90" width="900" height="940" as="geometry"/></mxCell><mxCell id="z_shared" value="Dùng chung" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=0;pointerEvents=0;fillColor=#ffffff;strokeColor=#9aa0a6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="390" y="850" width="860" height="160" as="geometry"/></mxCell><mxCell id="z_ext" value="Dịch vụ AI" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=0;pointerEvents=0;fillColor=#f8f9fa;strokeColor=#9aa0a6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#5f6368;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1300" y="650" width="260" height="200" as="geometry"/></mxCell><mxCell id="cam" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=2;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="260" height="80" as="geometry"/></mxCell><mxCell id="cami" value="" style="fontColor=#0066CC;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fillColor=#CCCCCC;strokeColor=#6881B3;gradientColor=none;gradientDirection=north;strokeWidth=2;shape=mxgraph.networks.security_camera;fillColor=#4285F4;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="cam"><mxGeometry x="14" y="23.5" width="44" height="33" as="geometry"/></mxCell><mxCell id="camt" value='&lt;b style="font-size:13.5px"&gt;Camera / đầu ghi NVR&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;luồng phụ RTSP có sẵn&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="cam"><mxGeometry x="70" y="6" width="182" height="68" as="geometry"/></mxCell><mxCell id="gw" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=1.5;dashed=1;dashPattern=6 4;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="50" y="270" width="260" height="110" as="geometry"/></mxCell><mxCell id="gwi" value="" style="verticalLabelPosition=bottom;html=1;verticalAlign=top;align=center;strokeColor=none;fillColor=#00BEF2;shape=mxgraph.azure.laptop;pointerEvents=1;fillColor=#4285F4;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="gw"><mxGeometry x="14" y="42.0" width="44" height="26" as="geometry"/></mxCell><mxCell id="gwt" value='&lt;b style="font-size:13.5px"&gt;Cổng phát luồng&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;go2rtc / ffmpeg: chỉ đóng gói lại&lt;br&gt;không giải mã, không GPU&lt;br&gt;lọc chuyển động (tùy chọn)&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="gw"><mxGeometry x="70" y="6" width="182" height="98" as="geometry"/></mxCell><mxCell id="phn" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=1.5;dashed=1;dashPattern=6 4;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="50" y="410" width="260" height="80" as="geometry"/></mxCell><mxCell id="phni" value="" style="sketch=0;verticalLabelPosition=bottom;sketch=0;aspect=fixed;html=1;verticalAlign=top;strokeColor=none;fillColor=#000000;align=center;outlineConnect=0;pointerEvents=1;shape=mxgraph.citrix2.mobile;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="phn"><mxGeometry x="14" y="18.0" width="22" height="44" as="geometry"/></mxCell><mxCell id="phnt" value='&lt;b style="font-size:13.5px"&gt;Điện thoại làm camera&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;WebSocket JPEG, lên thẳng cloud&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="phn"><mxGeometry x="70" y="6" width="182" height="68" as="geometry"/></mxCell><mxCell id="edg" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285f4;strokeWidth=2;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="50" y="530" width="260" height="130" as="geometry"/></mxCell><mxCell id="edgi" value="" style="verticalLabelPosition=bottom;html=1;verticalAlign=top;align=center;strokeColor=none;fillColor=#00BEF2;shape=mxgraph.azure.laptop;pointerEvents=1;fillColor=#4285F4;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="edg"><mxGeometry x="14" y="52.0" width="44" height="26" as="geometry"/></mxCell><mxCell id="edgt" value='&lt;b style="font-size:13.5px"&gt;Edge compute (tùy chọn)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;máy có GPU, như demo hiện tại&lt;br&gt;tự suy luận, chỉ gửi sự kiện&lt;br&gt;dùng khi mạng yếu hoặc cần offline&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="edg"><mxGeometry x="70" y="6" width="182" height="118" as="geometry"/></mxCell><mxCell id="own" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=2;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="50" y="780" width="260" height="90" as="geometry"/></mxCell><mxCell id="owni" value="" style="image;aspect=fixed;perimeter=ellipsePerimeter;html=1;align=center;shadow=0;dashed=0;spacingTop=3;image=img/lib/active_directory/users.svg;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="own"><mxGeometry x="14" y="23.0" width="29" height="44" as="geometry"/></mxCell><mxCell id="ownt" value='&lt;b style="font-size:13.5px"&gt;Chủ quán: trình duyệt&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;quản lý, trợ lý, cài đặt&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="own"><mxGeometry x="70" y="6" width="182" height="78" as="geometry"/></mxCell><mxCell id="stf" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=2;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="50" y="900" width="260" height="110" as="geometry"/></mxCell><mxCell id="stfi" value="" style="sketch=0;verticalLabelPosition=bottom;sketch=0;aspect=fixed;html=1;verticalAlign=top;strokeColor=none;fillColor=#000000;align=center;outlineConnect=0;pointerEvents=1;shape=mxgraph.citrix2.mobile;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="stf"><mxGeometry x="14" y="33.0" width="22" height="44" as="geometry"/></mxCell><mxCell id="stft" value='&lt;b style="font-size:13.5px"&gt;Nhân viên: điện thoại&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;nhận việc, rung, đọc to&lt;br&gt;không chạy AI trên máy&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="stf"><mxGeometry x="70" y="6" width="182" height="98" as="geometry"/></mxCell><mxCell id="ing" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=1.5;dashed=1;dashPattern=6 4;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="250" height="120" as="geometry"/></mxCell><mxCell id="ingi" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="ing"><mxGeometry x="14" y="38.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="ingt" value='&lt;b style="font-size:13.5px"&gt;Cổng nhận video&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;GKE/GCE: RTSP, SRT, WebRTC&lt;br&gt;Cloud Run: WebSocket JPEG&lt;br&gt;H.264 chưa giải mã ở đây&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="ing"><mxGeometry x="70" y="6" width="172" height="108" as="geometry"/></mxCell><mxCell id="prep" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=1.5;dashed=1;dashPattern=6 4;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="250" height="120" as="geometry"/></mxCell><mxCell id="prepi" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="prep"><mxGeometry x="14" y="38.0" width="37" height="44" as="geometry"/></mxCell><mxCell id="prept" value='&lt;b style="font-size:13.5px"&gt;Tiền xử lý (GPU)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;giải mã NVDEC, lấy mẫu ~5 fps&lt;br&gt;khung thô chỉ nằm trong RAM&lt;br&gt;không ghi đĩa, không lưu&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="prep"><mxGeometry x="70" y="6" width="172" height="108" as="geometry"/></mxCell><mxCell id="bus" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=1.5;dashed=1;dashPattern=6 4;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="250" height="120" as="geometry"/></mxCell><mxCell id="busi" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="bus"><mxGeometry x="14" y="38.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="bust" value='&lt;b style="font-size:13.5px"&gt;Hàng khung (Redis)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;mỗi camera một khe&lt;br&gt;khung mới thắng, bỏ khung cũ&lt;br&gt;không dồn ứ khi quá tải&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="bus"><mxGeometry x="70" y="6" width="172" height="108" as="geometry"/></mxCell><mxCell id="reg" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=1.5;dashed=1;dashPattern=6 4;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="400" y="330" width="250" height="120" as="geometry"/></mxCell><mxCell id="regi" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="reg"><mxGeometry x="14" y="40.0" width="44" height="40" as="geometry"/></mxCell><mxCell id="regt" value='&lt;b style="font-size:13.5px"&gt;Kho model&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;engine TensorRT theo loại GPU&lt;br&gt;CI build, đo, rồi mới bật&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="reg"><mxGeometry x="70" y="6" width="172" height="108" as="geometry"/></mxCell><mxCell id="inf" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=1.5;dashed=1;dashPattern=6 4;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="700" y="330" width="250" height="120" as="geometry"/></mxCell><mxCell id="infi" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="inf"><mxGeometry x="14" y="38.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="inft" value='&lt;b style="font-size:13.5px"&gt;Suy luận GPU (Triton)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;YOLO pose/det, YOLOE, RTMPose&lt;br&gt;PE-Core S/B + 3 đầu phân loại&lt;br&gt;không trạng thái, gộp lô&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="inf"><mxGeometry x="70" y="6" width="172" height="108" as="geometry"/></mxCell><mxCell id="wrk" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=1.5;dashed=1;dashPattern=6 4;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="250" height="120" as="geometry"/></mxCell><mxCell id="wrki" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="wrk"><mxGeometry x="14" y="38.0" width="37" height="44" as="geometry"/></mxCell><mxCell id="wrkt" value='&lt;b style="font-size:13.5px"&gt;Worker camera (CPU)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;tracker, vùng bàn, máy trạng thái&lt;br&gt;làm mờ mặt từ khung xương,&lt;br&gt;rồi mới lưu hoặc gửi ảnh đi&lt;br&gt;chia theo camera&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="wrk"><mxGeometry x="70" y="6" width="172" height="108" as="geometry"/></mxCell><mxCell id="hub" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285f4;strokeWidth=2;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="400" y="510" width="250" height="120" as="geometry"/></mxCell><mxCell id="hubi" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="hub"><mxGeometry x="14" y="38.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="hubt" value='&lt;b style="font-size:13.5px"&gt;Hub điều phối&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;Cloud Run: chia việc, SSE&lt;br&gt;nhiều instance, không giữ&lt;br&gt;trạng thái trong RAM&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="hub"><mxGeometry x="70" y="6" width="172" height="108" as="geometry"/></mxCell><mxCell id="pub" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=1.5;dashed=1;dashPattern=6 4;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1000" y="510" width="250" height="120" as="geometry"/></mxCell><mxCell id="pubi" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="pub"><mxGeometry x="14" y="38.0" width="40" height="44" as="geometry"/></mxCell><mxCell id="pubt" value='&lt;b style="font-size:13.5px"&gt;Pub/Sub&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;sự kiện và ảnh bằng chứng&lt;br&gt;không được mất, có thử lại&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="pub"><mxGeometry x="70" y="6" width="172" height="108" as="geometry"/></mxCell><mxCell id="fs" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=1.5;dashed=1;dashPattern=6 4;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="400" y="690" width="250" height="120" as="geometry"/></mxCell><mxCell id="fsi" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="fs"><mxGeometry x="14" y="38.0" width="37" height="44" as="geometry"/></mxCell><mxCell id="fst" value='&lt;b style="font-size:13.5px"&gt;Firestore&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;việc, bàn, cài đặt, nhật ký&lt;br&gt;dùng chung giữa các instance&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="fs"><mxGeometry x="70" y="6" width="172" height="108" as="geometry"/></mxCell><mxCell id="sto" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;strokeWidth=2;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="700" y="690" width="250" height="120" as="geometry"/></mxCell><mxCell id="stoi" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="sto"><mxGeometry x="14" y="42.5" width="44" height="35" as="geometry"/></mxCell><mxCell id="stot" value='&lt;b style="font-size:13.5px"&gt;Cloud Storage&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;ảnh bằng chứng đã làm mờ&lt;br&gt;xóa sau N ngày&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="sto"><mxGeometry x="70" y="6" width="172" height="108" as="geometry"/></mxCell><mxCell id="ver" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285f4;strokeWidth=2;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1000" y="690" width="250" height="120" as="geometry"/></mxCell><mxCell id="veri" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="ver"><mxGeometry x="14" y="38.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="vert" value='&lt;b style="font-size:13.5px"&gt;Verifier&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;Cloud Run: hàng đợi, giới hạn&lt;br&gt;tốc độ gọi Gemini&lt;br&gt;báo trước, xác nhận sau&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="ver"><mxGeometry x="70" y="6" width="172" height="108" as="geometry"/></mxCell><mxCell id="sec" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;strokeWidth=2;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="410" y="890" width="260" height="100" as="geometry"/></mxCell><mxCell id="seci" value="" style="sketch=0;html=1;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;spacingTop=-6;fontSize=11;fontStyle=1;fontColor=#999999;shape=image;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="sec"><mxGeometry x="14" y="37.0" width="44" height="26" as="geometry"/></mxCell><mxCell id="sect" value='&lt;b style="font-size:13.5px"&gt;Secret Manager&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;EDGE_KEY, khoá LLM&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="sec"><mxGeometry x="70" y="6" width="182" height="88" as="geometry"/></mxCell><mxCell id="mon" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;strokeWidth=2;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="700" y="890" width="260" height="100" as="geometry"/></mxCell><mxCell id="moni" value="" style="sketch=0;html=1;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;spacingTop=-6;fontSize=11;fontStyle=1;fontColor=#999999;shape=image;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="mon"><mxGeometry x="14" y="35.0" width="44" height="30" as="geometry"/></mxCell><mxCell id="mont" value='&lt;b style="font-size:13.5px"&gt;Cloud Monitoring&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;SLO độ trễ, GPU, độ sâu hàng&lt;br&gt;cảnh báo, ngân sách&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="mon"><mxGeometry x="70" y="6" width="182" height="88" as="geometry"/></mxCell><mxCell id="tf" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#7b42bc;strokeWidth=2;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="990" y="890" width="250" height="100" as="geometry"/></mxCell><mxCell id="tfi" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="tf"><mxGeometry x="14" y="28.0" width="37" height="44" as="geometry"/></mxCell><mxCell id="tft" value='&lt;b style="font-size:13.5px"&gt;Terraform + Cloud Build&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;hạ tầng và image&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="tf"><mxGeometry x="70" y="6" width="172" height="88" as="geometry"/></mxCell><mxCell id="gem" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#ea4335;strokeWidth=2;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1315" y="695" width="230" height="110" as="geometry"/></mxCell><mxCell id="gemi" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;labelPosition=center;verticalLabelPosition=middle;fontSize=1;" vertex="1" parent="gem"><mxGeometry x="14" y="33.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="gemt" value='&lt;b style="font-size:13.5px"&gt;Gemini qua Vertex AI&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3c4043"&gt;service account, không cần khoá&lt;br&gt;(demo: khoá API)&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="gem"><mxGeometry x="70" y="6" width="152" height="98" as="geometry"/></mxCell><mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#202124;labelBackgroundColor=#202124;fontColor=#ffffff;fontStyle=1;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cam" target="gw"><mxGeometry relative="1" x="0" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#202124;labelBackgroundColor=#202124;fontColor=#ffffff;fontStyle=1;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="ing"